{
  "name": "hackerton",
  "version": "1.0.0",
  "description": "ComPasser — 고정 일정(Anchor) 중심 AI 여행 동선 최적화 플래너 (Ionic React 셸 + Web Components + Vite + Firebase)",
  "scripts": {
    "dev": "vite",
    "dev:ionic": "vite",
    "build": "vite build",
    "build:ionic": "vite build",
    "build:release": "vite build",
    "lint": "oxlint src functions scripts test",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "test:ionic": "playwright test --config playwright.ionic.config.mjs",
    "test:ionic:pwa": "playwright test --config playwright.ionic-pwa.config.mjs",
    "test:browser:install": "node scripts/install-test-browser.mjs",
    "test:emulator": "node scripts/test-emulators.mjs",
    "check": "npm test && npm run build && npm run test:browser && npm run test:emulator",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:ios": "npm run cap:sync && npx cap run ios",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "deploy:functions": "firebase deploy --only functions"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.4.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@ionic/react": "^9.0.5",
    "@ionic/react-router": "^9.0.5",
    "d3-geo": "3.1.1",
    "firebase": "^12.18.0",
    "html2canvas-pro": "^2.3.9",
    "ionicons": "^8.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "1.63.0",
    "esbuild": "^0.21.5",
    "firebase-tools": "15.30.0",
    "oxlint": "1.86.0",
    "vite": "^5.2.0",
    "wrangler": "^4.136.3"
  }
}
