# ComPasser 환경변수 예시
# 실제 값은 .env 에 작성하세요. .env 는 .gitignore 로 제외됩니다.

# ---------------------------------------------------------------
# 프론트엔드 (Vite) — VITE_ 접두사만 브라우저 번들에 주입됩니다.
# 여기에 있는 값은 클라이언트에 노출되는 것을 전제로 합니다.
# ---------------------------------------------------------------
VITE_MAPS_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GA_MEASUREMENT_ID=
VITE_KAKAO_APP_KEY=
VITE_NAVER_CLIENT_ID=

# ---------------------------------------------------------------
# 서버 전용 — 번들에 절대 포함되지 않습니다.
# Gemini 키는 generateItinerary Cloud Function 에서만 사용합니다.
#   배포용:     firebase functions:secrets:set GEMINI_API_KEY
#   에뮬레이터: functions/.env.local 에 GEMINI_API_KEY=... 작성
# ---------------------------------------------------------------
GEMINI_API_KEY=
