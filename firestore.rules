rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function canWriteAccountData() {
      let path = /databases/$(database)/documents/account_deletions/$(request.auth.uid);
      // Completed jobs still fence old ID tokens. A new sign-in after completion
      // can write again; a pending/blocked job can only be changed by Admin.
      return !exists(path) || (get(path).data.state == 'completed'
        && request.auth.token.auth_time > get(path).data.completedAt / 1000);
    }

    match /account_deletions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /account_deletion_receipts/{receiptId} {
      allow read, write: if false;
    }

    match /discovery_popularity/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    match /discovery_saves/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // users/{uid}: 프로필 문서. 현재 클라이언트가 쓰는 필드는 birthday뿐이다.
    // 과거 phoneNumber/isVerified를 구버전 클라이언트가 다시 기록하지 못하게 한다.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && canWriteAccountData()
        && request.resource.data.keys().hasOnly(['birthday'])
        && request.resource.data.birthday is string;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && canWriteAccountData()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['birthday'])
        && request.resource.data.birthday is string;
      allow delete: if false;
    }

    // itineraries/{id}: 로그인 사용자가 저장한 개인 일정. userId 필드로 소유자를 식별한다.
    // (src/domains/itinerary/services/firestore-service.js: saveItinerary/updateItinerary/renameItinerary/getUserItineraries/deleteItinerary)
    match /itineraries/{itineraryId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && canWriteAccountData();

      // 소유자는 이름(title)과 저장한 일정 내용(itineraryPlan)만 고칠 수 있다.
      // 소유자(userId)와 저장 시각(createdAt)은 바꾸거나 지울 수 없다.
      // 바뀐 필드만 검사해 이름이 없던 예전 일정도 내용을 고칠 수 있다.
      allow update: if request.auth != null
        && canWriteAccountData()
        && resource.data.userId == request.auth.uid
        && validItineraryEdit(request.resource.data.diff(resource.data).affectedKeys());
    }

    function validItineraryEdit(changed) {
      return changed.hasOnly(['title', 'itineraryPlan'])
        && (!changed.hasAny(['title']) || (request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100))
        && (!changed.hasAny(['itineraryPlan']) || request.resource.data.itineraryPlan is map);
    }

    function validVisitorInfo(info) {
      return info is map && info.keys().hasOnly(['englishMenu', 'reservation', 'sourceUrl', 'checkedOn'])
        && info.keys().hasAll(['englishMenu', 'reservation', 'sourceUrl', 'checkedOn'])
        && info.englishMenu in ['unknown', 'available', 'unavailable']
        && info.reservation in ['unknown', 'required', 'recommended', 'not_required']
        && info.sourceUrl is string && info.sourceUrl.size() <= 500 && info.sourceUrl.matches('^https?://[^ ]+$')
        && info.checkedOn is string && info.checkedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validPublicStop(stop) {
      return stop is map
        && stop.keys().hasOnly(['name', 'location', 'stayMinutes', 'englishName', 'visitorInfo'])
        && stop.keys().hasAll(['name', 'location', 'stayMinutes'])
        && stop.name is string && stop.name.size() > 0 && stop.name.size() <= 100
        && stop.location is string && stop.location.size() > 0 && stop.location.size() <= 200
        && stop.stayMinutes is number && stop.stayMinutes >= 20 && stop.stayMinutes <= 360
        && (!('englishName' in stop) || (stop.englishName is string && stop.englishName.size() > 0 && stop.englishName.size() <= 100))
        && (!('visitorInfo' in stop) || validVisitorInfo(stop.visitorInfo));
    }

    function validRouteExtras(data) {
      return (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() > 0 && data.titleEn.size() <= 100))
        && (!('credit' in data) || (data.credit is map && data.credit.keys().hasOnly(['name', 'url'])
          && data.credit.keys().hasAll(['name', 'url']) && data.credit.name is string
          && data.credit.name.size() > 0 && data.credit.name.size() <= 80 && data.credit.url is string
          && data.credit.url.size() <= 500 && (data.credit.url == '' || data.credit.url.matches('^https?://[^ ]+$'))));
    }

    function validPublicStops(stops) {
      return stops is list && stops.size() >= 2 && stops.size() <= 6
        && validPublicStop(stops[0]) && validPublicStop(stops[1])
        && (stops.size() < 3 || validPublicStop(stops[2]))
        && (stops.size() < 4 || validPublicStop(stops[3]))
        && (stops.size() < 5 || validPublicStop(stops[4]))
        && (stops.size() < 6 || validPublicStop(stops[5]));
    }

    // Only an owner-approved projection is public; private dates and fixed visits stay in itineraries.
    match /public_courses/{sourceId} {
      allow read: if true;
      allow create, update: if request.auth != null && canWriteAccountData()
        && request.resource.data.keys().hasOnly(['ownerId', 'sourceId', 'title', 'stops', 'review', 'createdAt', 'titleEn', 'credit'])
        && request.resource.data.keys().hasAll(['ownerId', 'sourceId', 'title', 'stops', 'review', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sourceId == sourceId
        && sourceId.matches('^[a-zA-Z0-9]+$')
        && get(/databases/$(database)/documents/itineraries/$(sourceId)).data.userId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.review is string && request.resource.data.review.size() <= 300
        && request.resource.data.createdAt is timestamp
        && (request.method != 'create' || request.resource.data.createdAt == request.time)
        && validPublicStops(request.resource.data.stops)
        && validRouteExtras(request.resource.data)
        && (request.method == 'create' || (resource.data.ownerId == request.auth.uid
          && ((request.resource.data.stops == resource.data.stops && request.resource.data.createdAt == resource.data.createdAt)
            || (request.resource.data.stops != resource.data.stops && request.resource.data.createdAt == request.time))));
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    function reviewIsPublic(data) {
      let course = /databases/$(database)/documents/public_courses/$(data.courseId);
      return exists(course) && data.courseCreatedAt == get(course).data.createdAt;
    }

    match /course_reviews/{reviewId} {
      allow get: if !exists(/databases/$(database)/documents/course_reviews/$(reviewId))
        || (request.auth != null && resource.data.userId == request.auth.uid)
        || reviewIsPublic(resource.data);
      allow list: if reviewIsPublic(resource.data);
      allow create, update: if request.auth != null && canWriteAccountData()
        && request.resource.data.keys().hasOnly(['userId', 'courseId', 'courseCreatedAt', 'createdAt', 'visitDate', 'comment', 'walkingKm', 'spentWon', 'visitMinutes'])
        && request.resource.data.keys().hasAll(['userId', 'courseId', 'courseCreatedAt', 'createdAt', 'visitDate', 'comment', 'walkingKm', 'spentWon', 'visitMinutes'])
        && request.resource.data.userId == request.auth.uid
        && reviewId == request.resource.data.courseId + '_' + request.auth.uid
        && (request.method == 'create' || resource.data.userId == request.auth.uid)
        && reviewIsPublic(request.resource.data)
        && get(/databases/$(database)/documents/public_courses/$(request.resource.data.courseId)).data.ownerId != request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.visitDate is string && request.resource.data.visitDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.comment is string && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 600
        && (request.resource.data.walkingKm == null || (request.resource.data.walkingKm is number && request.resource.data.walkingKm >= 0 && request.resource.data.walkingKm <= 100))
        && (request.resource.data.spentWon == null || (request.resource.data.spentWon is int && request.resource.data.spentWon >= 0 && request.resource.data.spentWon <= 10000000))
        && (request.resource.data.visitMinutes == null || (request.resource.data.visitMinutes is int && request.resource.data.visitMinutes >= 0 && request.resource.data.visitMinutes <= 1440));
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // shared_itineraries/{id}: 공유 링크로 배포되는 일정. 비로그인 게스트도 조회 가능해야 한다
    // (PRD Non-Goals: "Itinerary sharing is read-only for guests").
    // 생성은 로그인 사용자만 가능 (generateItinerary 자체가 로그인 필수이므로 공유 버튼 노출 시점엔 항상 인증됨).
    // 생성 후에는 불변 — 수정/삭제 불가.
    match /shared_itineraries/{sharedId} {
      // Legacy snapshots have no reliable source identity. New snapshots are
      // readable only while the original private document still belongs to its owner.
      allow get: if !exists(/databases/$(database)/documents/shared_itineraries/$(sharedId)) || !('sourceId' in resource.data)
        || (exists(/databases/$(database)/documents/itineraries/$(resource.data.sourceId))
          && get(/databases/$(database)/documents/itineraries/$(resource.data.sourceId)).data.userId == resource.data.ownerId);
      allow create: if request.auth != null && canWriteAccountData()
        && request.resource.data.keys().hasOnly(['itineraryPlan', 'createdAt', 'sourceId', 'ownerId'])
        && request.resource.data.sourceId is string
        && request.resource.data.sourceId.matches('^[a-zA-Z0-9]+$')
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/itineraries/$(request.resource.data.sourceId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/shared_itinerary_status/$(sharedId)).data.sourceId == request.resource.data.sourceId
        && getAfter(/databases/$(database)/documents/shared_itinerary_status/$(sharedId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // A content-free deletion receipt: only readable when the source is gone.
    // Its successful server read distinguishes deletion from network/auth errors.
    match /shared_itinerary_status/{sharedId} {
      allow get: if !exists(/databases/$(database)/documents/itineraries/$(resource.data.sourceId))
        || get(/databases/$(database)/documents/itineraries/$(resource.data.sourceId)).data.userId != resource.data.ownerId;
      allow create: if request.auth != null && canWriteAccountData()
        && request.resource.data.keys().hasOnly(['sourceId', 'ownerId'])
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/shared_itineraries/$(sharedId)).data.sourceId == request.resource.data.sourceId
        && getAfter(/databases/$(database)/documents/shared_itineraries/$(sharedId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // 정의되지 않은 모든 경로는 기본 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
